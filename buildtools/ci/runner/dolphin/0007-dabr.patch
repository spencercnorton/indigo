@@ -405,6 +406,35 @@ TMemCheck* MemChecks::GetMemCheck(u32 address, size_t size)
   return &*iter;
 }
 
+// With DOLPHIN_DABR set, every doubleword the DABR names gets a watch, so
+// accesses there take the slow path, where MMU::Memcheck raises the DSI a 750
+// would while it is the DABR's current one. libogc guards each thread's stack
+// this way and switches the DABR with the thread, so a guard stays watched once
+// named. MMU mode already compiles watch-capable code: no JIT cache clear,
+// which mtspr could not do safely anyway.
+// ponytail: one watch per guard ever named, never removed; a cap if a program
+// ever creates threads without end.
+void MemChecks::WatchDABR(u32 dabr)
+{
+  static const bool enabled = std::getenv("DOLPHIN_DABR") != nullptr;
+  if (!enabled || !m_system.IsMMUMode() || (dabr & 3) == 0)
+    return;
+  const u32 start = dabr & ~7u;
+  if (std::ranges::any_of(m_mem_checks, [start](const TMemCheck& mc) {
+        return mc.is_dabr && mc.start_address == start;
+      }))
+    return;
+  TMemCheck watch;
+  watch.start_address = start;
+  watch.end_address = start + 7;
+  watch.is_ranged = true;
+  watch.is_break_on_read = true;
+  watch.is_break_on_write = true;
+  watch.is_dabr = true;
+  m_mem_checks.push_back(std::move(watch));
+  m_system.GetMMU().DBATUpdated();
+}
