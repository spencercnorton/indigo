-void MMU::Memcheck(u32 address, u64 var, bool write, size_t size)
+// A 750 raises a DSI, and does not make the access, when it touches the
+// doubleword its DABR names: a read if DR is set, a write if DW, while data
+// translation (MSR[DR]) is as BT says. Returns whether it did.
+bool MMU::DABRMatch(u32 address, bool write, size_t size)
+{
+  const u32 dabr = m_ppc_state.spr[SPR_DABR];
+  const u32 start = dabr & ~7u;
+  if (!(dabr & (write ? 2u : 1u)) || bool(dabr & 4) != bool(m_ppc_state.msr.DR) ||
+      address > start + 7 || address + size - 1 < start)
+    return false;
+  NOTICE_LOG_FMT(POWERPC, "DABR: {} {:#010x} at PC {:#010x}, the doubleword the DABR guards",
+                 write ? "write to" : "read of", address, m_ppc_state.pc);
+  m_ppc_state.spr[SPR_DAR] = address;
+  m_ppc_state.spr[SPR_DSISR] = (1U << 22) | (write ? 1U << 25 : 0);  // DABR match; a store
+  m_ppc_state.Exceptions |= EXCEPTION_DSI;
+  return true;
+}
