+static u16 ComputeCRC16(const u8* data, int len)
+{
+  u16 crc = 0;
+  for (int i = 0; i < len; i++)
+    crc = s_crc16_table[((crc >> 8) ^ data[i]) & 0xFF] ^ (crc << 8);
+  return crc;
+}
