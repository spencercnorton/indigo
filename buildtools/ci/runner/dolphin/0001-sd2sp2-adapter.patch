+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+#include "Common/IOFile.h"
+#include "Core/HW/EXI/EXI_Device.h"
+
+namespace ExpansionInterface
+{
+// SD card in SPI mode emulation for SD2SP2 (GameCube Serial Port 2 SD adapter).
+// Implements the SD SPI protocol over EXI byte transfers.
+class CEXISDCard : public IEXIDevice
+{
+public:
+  explicit CEXISDCard(Core::System& system);
+  bool IsPresent() const override;
+  void SetCS(int cs) override;
+  void DoState(PointerWrap& p) override;
+  void ImmReadWrite(u32& data, u32 size) override;
+  u32 ImmRead(u32 size) override;
+  void DMARead(u32 address, u32 size) override;
+  void DMAWrite(u32 address, u32 size) override;
+
+private:
+  void TransferByte(u8& byte) override;
+
+  void ProcessCommand();
+  void BuildCSD();
+  void BuildCID();
+
+  bool ReadSector(u32 sector, u8* buf);
+  bool WriteSector(u32 sector, const u8* buf);
+
+  enum class State
+  {
+    Idle,
+    CmdReceive,
+    Response,
+    DataReadToken,
+    DataRead,
+    DataWriteToken,
+    DataWrite,
+    DataWriteResponse,
+  };
+
+  State m_state = State::Idle;
+
+  // Command receive buffer (6 bytes: start_bit|transmission_bit|cmd[5:0], arg[31:0], crc|stop_bit)
+  std::array<u8, 6> m_cmd_buf{};
+  int m_cmd_byte_idx = 0;
+
+  // Response buffer
+  std::vector<u8> m_response;
+  size_t m_response_idx = 0;
+
+  // Data transfer buffer (max 512 data bytes + 2 CRC bytes)
+  std::array<u8, 514> m_data_buf{};
+  int m_data_byte_idx = 0;
+  int m_data_size = 512;  // data bytes to transfer (not counting 2 CRC bytes)
+
+  // SD card state
+  bool m_app_cmd = false;
+  bool m_initialized = false;
+  bool m_multi_block = false;
+  bool m_pending_read = false;
+  bool m_pending_write = false;
+
+  u32 m_current_sector = 0;
+  u64 m_card_size_blocks = 0;
+
+  // Transfer tracking
+  u32 m_cmd18_start_sector = 0;
+  u32 m_cmd18_sector_count = 0;
+
+  File::IOFile m_card;
+};
+}  // namespace ExpansionInterface
