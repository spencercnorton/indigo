+CEXISDCard::CEXISDCard(Core::System& system) : IEXIDevice(system)
+{
+  const std::string image_path = Config::Get(Config::MAIN_SP2_SD_CARD_IMAGE);
+  INFO_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2: Device created, image path='{}'", image_path);
+  if (!image_path.empty())
+  {
+    m_card.Open(image_path, "r+b");
+    if (!m_card)
+    {
+      WARN_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2: Failed to open image '{}'", image_path);
+    }
+    else
+    {
+      m_card_size_blocks = m_card.GetSize() / 512;
+      INFO_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2: Opened '{}' ({} blocks, {} MB)", image_path,
+                   m_card_size_blocks, m_card_size_blocks / 2048);
+    }
+  }
+  else
+  {
+    WARN_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2: No image path configured");
+  }
+}
+
+bool CEXISDCard::IsPresent() const
+{
+  return m_card.IsOpen();
+}
+
+void CEXISDCard::SetCS(int cs)
+{
+  // libogc's sdgecko driver deselects CS between writing a command and reading
+  // the response. We must NOT reset the state machine on deselect, or the
+  // response will be lost. Only reset partial command reception.
+  if (!cs)
+  {
+    if (m_state == State::CmdReceive)
+    {
+      // Abort incomplete command
+      m_state = State::Idle;
+      m_cmd_byte_idx = 0;
+    }
+  }
+}
