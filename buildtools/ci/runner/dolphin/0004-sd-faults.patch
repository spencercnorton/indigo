+void CEXISDCard::ParseFaults(const char* faults)
+{
+  std::string spec(faults);
+  size_t start = 0;
+  while (start <= spec.size())
+  {
+    const size_t end = std::min(spec.find(',', start), spec.size());
+    const std::string item = spec.substr(start, end - start);
+    u32 first = 0, last = 0, count = 0;
+    if (std::sscanf(item.c_str(), "read-error=%u-%u", &first, &last) == 2)
+      m_read_errors.push_back({first, last});
+    else if (std::sscanf(item.c_str(), "write-error=%u-%u", &first, &last) == 2)
+      m_write_errors.push_back({first, last});
+    else if (std::sscanf(item.c_str(), "write-error-after=%u", &count) == 1)
+      m_write_error_after = count;
+    else if (!item.empty())
+      WARN_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2: unknown fault '{}'", item);
+    start = end + 1;
+  }
+  NOTICE_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2: faults '{}'", spec);
+}
+
+bool CEXISDCard::InRanges(const std::vector<SectorRange>& ranges, u32 sector)
+{
+  return std::any_of(ranges.begin(), ranges.end(),
+                     [sector](const SectorRange& r) { return sector >= r.first && sector <= r.last; });
+}
